# Contract addresses on Base Sepolia (chain ID 84532)
# Deploy with: ./scripts/deploy.sh
# Or set manually after running forge script
NEXT_PUBLIC_HCA_FACTORY=0x
NEXT_PUBLIC_LAMPORT_VERIFIER=0x
NEXT_PUBLIC_ECDSA_VERIFIER=0x
NEXT_PUBLIC_FALCON_VERIFIER=0x

# Pimlico bundler API key (get one at dashboard.pimlico.io)
NEXT_PUBLIC_PIMLICO_API_KEY=

# Deploy key (only needed for contract deployment, NOT for the app)
# PRIVATE_KEY=0x
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
